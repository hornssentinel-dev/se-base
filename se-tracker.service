[Unit]
Description=SE Tracker Application
After=network.target

[Service]
Type=simple
User=rphalen
WorkingDirectory=/home/rphalen/se_base
ExecStart=/usr/bin/node /home/rphalen/se_base/server.js
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Environment variables
Environment="NODE_ENV=production"
Environment="PORT=3000"

[Install]
WantedBy=multi-user.target
